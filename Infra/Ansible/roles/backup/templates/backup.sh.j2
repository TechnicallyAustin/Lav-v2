#!/usr/bin/env bash
# Managed by Ansible — do not edit manually.
set -euo pipefail

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="{{ backup_local_dir }}/${TIMESTAMP}"
mkdir -p "${BACKUP_DIR}"

# ---------------------------------------------------------------------------
# MinIO client
# ---------------------------------------------------------------------------
mc alias set {{ backup_minio_alias }} \
  {{ backup_minio_url }} \
  {{ backup_minio_user }} \
  {{ backup_minio_password }} \
  --quiet

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
{% for db in backup_pg_databases %}
echo "[backup] pg_dump {{ db }}"
PGPASSWORD="" pg_dump \
  -h {{ backup_pg_host }} \
  -p {{ backup_pg_port }} \
  -U {{ backup_pg_user }} \
  --format=custom \
  {{ db }} > "${BACKUP_DIR}/pg_{{ db }}_${TIMESTAMP}.dump"
{% endfor %}

# ---------------------------------------------------------------------------
# Qdrant snapshot
# ---------------------------------------------------------------------------
echo "[backup] qdrant snapshot"
COLLECTIONS=$(curl -sf {{ backup_qdrant_url }}/collections \
  | python3 -c "import sys,json; [print(c['name']) for c in json.load(sys.stdin)['result']['collections']]")

for COLLECTION in ${COLLECTIONS}; do
  SNAPSHOT=$(curl -sf -X POST \
    {{ backup_qdrant_url }}/collections/${COLLECTION}/snapshots \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['result']['name'])")
  curl -sf -o "${BACKUP_DIR}/qdrant_${COLLECTION}_${TIMESTAMP}.snapshot" \
    {{ backup_qdrant_url }}/collections/${COLLECTION}/snapshots/${SNAPSHOT}
done

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
echo "[backup] chromadb copy"
cp -a {{ backup_chromadb_data_dir }} "${BACKUP_DIR}/chromadb"

# ---------------------------------------------------------------------------
# Upload to MinIO
# ---------------------------------------------------------------------------
echo "[backup] uploading to minio"
mc mirror --quiet "${BACKUP_DIR}" \
  {{ backup_minio_alias }}/{{ backup_minio_bucket }}/${TIMESTAMP}/

# ---------------------------------------------------------------------------
# Prune local backups older than retention window
# ---------------------------------------------------------------------------
echo "[backup] pruning local backups older than {{ backup_retention_days }} days"
find {{ backup_local_dir }} -maxdepth 1 -type d \
  -mtime +{{ backup_retention_days }} -exec rm -rf {} +

echo "[backup] done: ${TIMESTAMP}"
